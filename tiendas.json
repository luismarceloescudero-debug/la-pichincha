    "catalogo": {
      "tipo": "api",
      "plantilla": "https://api.comparaya.net/api/products/category/{categoria}?page={n}&limit=100",
      "categorias": [
        "monitores",
        "placas-de-video",
        "notebooks",
        "celulares",
        "televisores",
        "consolas",
        "impresoras",
        "auriculares",
        "tablets"
      ],
      "lista": "data",
      "campos": {
        "nombre": "title",
        "precio": "price",
        "lista": "original_price",
        "url": "url",
        "via": "store_name"
      }
    },
    "extractor": null,
    "lista_es_oferta": true
  }
