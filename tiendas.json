{
  "_nota": "Cada tienda es configuracion, no codigo. Para sumar una nueva alcanza con agregar un bloque aca: 'python indexar.py --probar <url de un producto>' te dice que extractor le sirve. Para dar de baja una, activa: false. 'lista_es_oferta' marca las fuentes donde el precio tachado es una rebaja real; en las otras es la diferencia por medio de pago y no sirve para detectar ofertas. 'ficha' (opcional) pide la ficha de cada aviso de esos rubros para leer su part number cuando el listado no lo trae: un pedido por aviso, una sola vez, con tope por corrida y sin insistir si la tienda bloquea. 'sin_stock' (opcional) dice en que campo la fuente informa la disponibilidad y que valores son sin stock: esas filas no entran. 'tipo': 'vtex' lee una tienda VTEX por su API publica de catalogo (indexar.indexar_vtex): solo hace falta su 'base'; las categorias de tecnologia salen de su arbol (o de 'rubros', si se declara), y no se lee si su robots.txt prohibe /api/. El 'nombre' de una tienda que tambien llega por ComparaYa es el mismo que le da ComparaYa: asi cuenta como un solo comercio.",
  "compragamer": {
    "nombre": "CompraGamer",
    "color": "cg",
    "activa": true,
    "base": "https://compragamer.com",
    "catalogo": {
      "tipo": "json",
      "url": "https://static.compragamer.com/productos",
      "campos": {
        "id": "id_producto",
        "nombre": "nombre",
        "precio": "precioEspecial",
        "lista": "precioLista",
        "stock": "stock",
        "imagen": "imagenes",
        "sku": "codigo_principal"
      },
      "ruta": "producto/{slug}_{id}",
      "imagen_url": "https://imagenes.compragamer.com/productos/compragamer_Imganen_general_{nombre}-grn.jpg"
    },
    "extractor": "compragamer",
    "lista_es_oferta": false
  },
  "gamingcity": {
    "nombre": "Gaming City",
    "color": "gc",
    "activa": true,
    "base": "https://www.gamingcity.com.ar",
    "catalogo": {
      "tipo": "listados",
      "origen": {
        "tipo": "sitemap",
        "url": "https://www.gamingcity.com.ar/sitemap.xml",
        "contiene": "--prod--"
      },
      "pagina": "{listado}--view--grilla--ord--cArtCod-desc-{n}",
      "desde": 0,
      "tarjeta": "<div class=\"product\">",
      "re": {
        "url": "href=\"([a-z0-9-]+--det--\\d+)\"",
        "nombre": [
          "class=\"titprod\"[^>]*>([^<]{4,160})",
          "alt=\"([^\"]+)\""
        ],
        "precio": [
          "class=\"price-sales\">\\$\\s*([\\d.]+)",
          "class=\"price\"><span>\\$\\s*([\\d.]+)",
          "class=\"price\">[\\s\\S]{0,120}?\\$\\s*([\\d.]+)"
        ],
        "lista": [
          "class=\"price-standard\">\\$\\s*([\\d.]+)"
        ],
        "imagen": [
          "data-src=\"(https://www\\.gamingcity\\.com\\.ar/thumb/[^\"]+)\"",
          " src=\"(https://www\\.gamingcity\\.com\\.ar/thumb/[^\"]+)\""
        ]
      }
    },
    "extractor": "meta",
    "lista_es_oferta": true
  },
  "mexx": {
    "nombre": "Mexx",
    "color": "mx",
    "activa": true,
    "base": "https://www.mexx.com.ar",
    "catalogo": {
      "tipo": "listados",
