        "nombre": "\\.html\">([^<]{6,160})</a>",
        "precio": "class=\"price\"[\\s\\S]{0,400}?<b>\\$([\\d.]+)</b>",
        "imagen": "src=\"(https://mexx-img-2019\\.s3\\.amazonaws\\.com/[^\"]+)\""
      }
    },
    "extractor": "itemprop",
    "ficha": {"extractor": "mexx", "rubros": ["ram", "ssd"], "tope": 40},
    "lista_es_oferta": false
  },
