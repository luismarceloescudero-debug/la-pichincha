{
  "_nota": "Cada tienda es configuracion, no codigo. Para sumar una nueva alcanza con agregar un bloque aca: 'python indexar.py --probar <url de un producto>' te dice que extractor le sirve. Para dar de baja una, activa: false. 'lista_es_oferta' marca las fuentes donde el precio tachado es una rebaja real; en las otras es la diferencia por medio de pago y no sirve para detectar ofertas.",
  "compragamer": {
    "nombre": "CompraGamer",
    "color": "cg",
    "activa": true,
    "base": "https://compragamer.com",
    "catalogo": {
      "tipo": "json",
      "url": "https://static.compragamer.com/productos",
      "campos": {
        "id": "id_producto",
        "nombre": "nombre",
        "precio": "precioEspecial",
        "lista": "precioLista",
        "stock": "stock",
        "imagen": "imagenes"
      },
      "ruta": "producto/{slug}_{id}"
    },
    "extractor": "compragamer",
    "lista_es_oferta": false
  },
  "gamingcity": {
    "nombre": "Gaming City",
    "color": "gc",
    "activa": true,
    "base": "https://www.gamingcity.com.ar",
    "catalogo": {
      "tipo": "listados",
      "origen": {
        "tipo": "sitemap",
        "url": "https://www.gamingcity.com.ar/sitemap.xml",
        "contiene": "--prod--"
      },
      "pagina": "{listado}--view--grilla--ord--cArtCod-desc-{n}",
      "desde": 0,
      "tarjeta": "<div class=\"product\">",
      "re": {
        "url": "href=\"([a-z0-9-]+--det--\\d+)\"",
        "nombre": [
          "class=\"titprod\"[^>]*>([^<]{4,160})",
          "alt=\"([^\"]+)\""
        ],
        "precio": [
          "class=\"price-sales\">\\$\\s*([\\d.]+)",
          "class=\"price\"><span>\\$\\s*([\\d.]+)",
          "class=\"price\">[\\s\\S]{0,120}?\\$\\s*([\\d.]+)"
        ],
        "lista": [
          "class=\"price-standard\">\\$\\s*([\\d.]+)"
        ],
        "imagen": "src=\"([^\"]*)\""
      }
    },
    "extractor": "meta",
    "lista_es_oferta": true
  },
  "mexx": {
    "nombre": "Mexx",
    "color": "mx",
    "activa": true,
    "base": "https://www.mexx.com.ar",
    "catalogo": {
      "tipo": "listados",
      "origen": {
        "tipo": "enlaces",
        "url": "https://www.mexx.com.ar/",
        "re": "href=\"(https://www\\.mexx\\.com\\.ar/productos-rubro/[a-z0-9-]+/)\""
      },
      "pagina": "{listado}?pagina={n}",
      "desde": 1,
      "tarjeta": "<div class=\"productos ",
      "re": {
        "url": "href=\"(https://www\\.mexx\\.com\\.ar/productos-rubro/[^\"]+\\.html)\"",
        "nombre": "\\.html\">([^<]{6,160})</a>",
        "precio": "class=\"price\"[\\s\\S]{0,400}?<b>\\$([\\d.]+)</b>",
        "imagen": "src=\"([^\"]*)\""
      }
    },
    "extractor": "itemprop",
    "lista_es_oferta": false
  },
  "fullh4rd": {
    "nombre": "FullH4rd",
    "color": "fh",
    "activa": true,
    "base": "https://fullh4rd.com.ar",
    "catalogo": {
      "tipo": "listados",
      "origen": {
        "tipo": "terminos",
        "plantilla": "https://fullh4rd.com.ar/buscar?q={termino}",
        "terminos": [
          "memoria",
          "procesador",
          "placa de video",
          "motherboard",
          "ssd",
          "disco rigido",
          "fuente",
          "gabinete",
          "monitor",
          "teclado",
          "mouse",
          "auriculares",
          "webcam",
          "notebook",
          "cooler",
          "impresora",
          "silla",
          "parlante",
          "microfono",
          "cable",
          "placa de sonido",
          "capturadora",
          "router",
          "pendrive",
          "joystick",
          "ups"
        ]
      },
      "pagina": "{listado}&pag={n}",
      "desde": 1,
      "tarjeta": "<article class=\"results-card\">",
      "re": {
        "url": "href=\"(/prod/\\d+/[a-z0-9-]+)\"",
        "nombre": "results-card__title\"[^>]*>\\s*<a[^>]*>([^<]{4,160})",
        "precio": "results-card__price-current\"[^>]*>\\s*\\$([\\d.]+)",
        "lista": "results-card__price-list\"[^>]*>\\s*\\$([\\d.]+)",
        "imagen": "src=\"([^\"]*)\""
      }
    },
    "extractor": "og",
    "lista_es_oferta": false
  },
  "comparaya": {
    "nombre": "ComparaYa",
    "color": "cy",
    "activa": true,
