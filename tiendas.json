  "comparaya": {
    "nombre": "ComparaYa",
    "color": "cy",
    "activa": true,
    "segunda_opinion": true,
    "_nota": "No es una tienda: es un comparador que agrega 65 comercios. Cada resultado dice de que comercio sale.",
    "base": "https://comparaya.net",
    "catalogo": {
      "tipo": "api",
      "plantilla": "https://api.comparaya.net/api/products/category/{categoria}?page={n}&limit=100",
      "categorias": [
        "monitores",
        "placas-de-video",
        "notebooks",
        "celulares",
        "televisores",
        "consolas",
        "impresoras",
        "auriculares",
        "tablets"
      ],
      "lista": "data",
      "campos": {
        "nombre": "title",
        "precio": "price",
        "lista": "original_price",
        "url": "url",
        "via": "store_name",
        "imagen": "image",
        "marca": "brand",
        "specs": "extracted_specs",
        "modelo": "specifications.Modelo"
      },
      "sellos": {
        "i": "specifications.is_international",
        "o": "specifications.Tienda oficial",
        "e": "specifications.Envío gratis",
        "s": "specifications.Sin interés"
      },
      "usados": {
        "campo": "condition",
        "valores": ["open_box", "used", "refurbished", "refurbished_international"]
      },
      "sin_stock": {
        "campo": "availability",
        "valores": ["out_of_stock", "sold_out", "discontinued", "unavailable"]
      }
    },
    "extractor": null,
    "lista_es_oferta": true
  },
